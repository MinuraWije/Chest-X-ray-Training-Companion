# Copy to .env and fill in. Never commit .env.
#
# Settings are loaded by `cxt.infrastructure.config.settings.Settings`
# (Pydantic Settings). Names are case-insensitive; the pydantic field
# name maps to the UPPER_CASE env var.

# --- General ---------------------------------------------------------------
# NOTE: `Settings` has no APP_ENV / APP_HOST / APP_PORT / APP_CORS_ORIGINS
# fields — the real names are ENVIRONMENT and CORS_ALLOW_ORIGINS. Host and
# port are arguments to `python scripts\dev.py run`, not settings.
ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
# Pydantic Settings decodes non-scalar fields from .env as JSON,
# so this must be a JSON array, not a comma-separated list.
CORS_ALLOW_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- Auth (Step 5) ---------------------------------------------------------
# Symmetric secret for PyJWT. REPLACE in any real deployment.
AUTH_JWT_SECRET=dev-only-not-for-production-replace-in-prod
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=cxt-companion
AUTH_JWT_AUDIENCE=cxt-companion
# 8h default
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800

# --- Admin (Step 5) --------------------------------------------------------
# Read by `scripts/seed_admin.py` from the real environment, not from this
# file (it uses os.environ, not Settings). Export them or pass
# --email / --password instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production-12345

# --- Database (Step 5) -----------------------------------------------------
DATABASE_URL=sqlite+pysqlite:///./cxt.db

# --- Data ------------------------------------------------------------------
# Where the manifest + images live. Defaults match the project layout.
DATA_DIR=../data
PROCESSED_DIR=../data/processed
IMAGES_DIR=../data/processed/images
MANIFEST_PATH=../data/processed/manifest.csv

# --- MedGemma runtime ------------------------------------------------------
# MEDGEMMA_RUNTIME is the ONLY switch between real and canned inference.
# (There is no MEDGEMMA_DRY_RUN setting — it is ignored if you set it.)
#   kaggle_tunnel = real calls through the ngrok URL below.
#   dry_run       = canned feedback, no network; default for dev and tests.
MEDGEMMA_RUNTIME=dry_run
# Printed by the Kaggle notebook. Changes every time the notebook restarts.
MEDGEMMA_TUNNEL_URL=
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
# 300 is too small for the four-field feedback schema — the object truncates.
MEDGEMMA_MAX_NEW_TOKENS=512
MEDGEMMA_TIMEOUT_SECONDS=120
MEDGEMMA_MAX_RETRIES=3
# Loading a 4-bit 4B checkpoint on a cold notebook takes minutes.
MEDGEMMA_WARMUP_TIMEOUT_SECONDS=600
# Corrective re-prompts when the model's JSON cannot be parsed or repaired.
MEDGEMMA_MAX_REPAIR_ATTEMPTS=1
MEDGEMMA_MAX_IMAGE_BYTES=8388608

# --- Evaluation guardrails --------------------------------------------------
MAX_EVAL_CASES=30

# --- Retrieval / RAG (Phase 2) ---------------------------------------------
# Which retrieval arm this process runs. `null` reproduces Phase 1 exactly and
# is the default, so an existing deployment is unchanged until you ask for
# more.
#   null           no passages. The p2.4 and p3.0-empty arms.
#   oracle         the case's confirmed category -> its chunks. An UPPER BOUND,
#                  not a retrieval result: it uses the answer key, so its
#                  precision is 1.0 by construction and is not reported.
#   bm25           BM25 over the student's own words. The only arm whose
#                  relevance figure is non-circular.
#   misconception  bm25, boosted toward chunks addressing what the student
#                  appears to have got wrong.
RETRIEVAL_RUNTIME=null

# Where the teaching corpus lives. The runtime reads `index.json`; rebuild it
# with `python scripts\dev.py corpus` after editing any data/corpus/*.md.
# CORPUS_DIR=../data/corpus

# Passages supplied per attempt. Three plus a 2000-char student answer plus the
# p3.0 template fit the notebook's 8000-char user turn with room to spare.
RETRIEVAL_TOP_K=3

# Normalised-score floor below which NO passages are supplied and the model is
# told so explicitly. Absolute rather than relative to the top hit, which is
# only possible because the score is saturating (bm25/(bm25+k)) rather than
# top-1 normalised. Raising it makes the system abstain more often; showing a
# student weak evidence "for completeness" teaches them to discount citations.
RETRIEVAL_SCORE_FLOOR=0.25
